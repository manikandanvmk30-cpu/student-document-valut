// Prisma schema for Student Document Vault (SDV)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  role          String // STUDENT, FACULTY, PLACEMENT_OFFICER, RECRUITER, DEPT_ADMIN, SUPER_ADMIN
  department    String?
  avatar        String?
  createdAt     DateTime        @default(now())
  profile       StudentProfile?
  documents     Document[]
  sessions      UserSession[]
  notifications Notification[]
}

model StudentProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId         String   @unique // e.g. 2026CSE042
  regNo             String?
  department        String
  batch             String // e.g. 2022-2026
  year              Int      @default(4)
  cgpa              Float    @default(8.42)
  phone             String?
  skills            String // JSON string array e.g. ["Java", "React", "Python"]
  projects          String // JSON string array of projects
  achievements      String // JSON string array of achievements
  completionPercent Int      @default(96)
  emergencyContact  String? // JSON string
  updatedAt         DateTime @updatedAt
}

model Document {
  id                 String              @id @default(uuid())
  docVerificationId  String              @unique // e.g. DOC-2026-CSE-000182
  title              String
  originalName       String
  fileName           String
  filePath           String
  fileSize           Int
  mimeType           String
  fileHash           String // SHA-256
  category           String // Academic, Certificates, Internship, Career, Other
  subCategory        String? // 10th, 12th, Semester 1, AWS, etc.
  tags               String // JSON string array e.g. ["#Java", "#Placement"]
  issuer             String?
  issueDate          String?
  expiryDate         String?
  certNumber         String?
  isFavorite         Boolean             @default(false)
  isPinned           Boolean             @default(false)
  isArchived         Boolean             @default(false)
  isRecycled         Boolean             @default(false)
  verificationStatus String              @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejectionReason    String?
  verifiedBy         String?
  verifiedAt         DateTime?
  currentVersion     Int                 @default(1)
  privacyLevel       String              @default("PRIVATE") // PRIVATE, COLLEGE_ONLY, RECRUITER_ONLY, PUBLIC_VERIFICATION
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions           DocumentVersion[]
  shares             DocumentShare[]
  accessLogs         DocumentAccessLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  fileName      String
  filePath      String
  fileSize      Int
  fileHash      String
  changeNotes   String?
  uploadedAt    DateTime @default(now())
}

model DocumentShare {
  id             String    @id @default(uuid())
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  shareToken     String    @unique
  passwordHash   String?
  expiresAt      DateTime?
  allowDownload  Boolean   @default(true)
  isRevoked      Boolean   @default(false)
  viewsCount     Int       @default(0)
  downloadsCount Int       @default(0)
  recipientNote  String?
  createdAt      DateTime  @default(now())
}

model DocumentAccessLog {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action      String // VIEW, DOWNLOAD, VERIFY, SHARE_CREATED, ACCESS_REVOKED
  performedBy String
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
}

model PlacementDrive {
  id               String                 @id @default(uuid())
  companyName      String
  companyLogo      String?
  roleTitle        String
  packageLpa       Float
  location         String
  minCgpa          Float
  eligibleDepts    String // JSON string array e.g. ["CSE", "IT", "ECE"]
  requiredDocTypes String // JSON string array e.g. ["Resume", "10th Marksheet", "Degree Certificate"]
  deadline         DateTime
  status           String                 @default("ACTIVE") // ACTIVE, CLOSED, UPCOMING
  description      String
  applications     PlacementApplication[]
  createdAt        DateTime               @default(now())
}

model PlacementApplication {
  id             String         @id @default(uuid())
  driveId        String
  drive          PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  studentId      String
  studentName    String
  studentDept    String
  studentCgpa    Float
  attachedDocIds String // JSON string array of Document IDs
  status         String         @default("APPLIED") // APPLIED, SHORTLISTED, VERIFIED, REJECTED, OFFERED
  appliedAt      DateTime       @default(now())
}

model RecruiterRequest {
  id                String    @id @default(uuid())
  recruiterName     String
  companyName       String
  studentId         String
  studentName       String?
  requestedDocTypes String // JSON string array e.g. ["Resume", "Latest Semester Marksheet"]
  deadline          DateTime
  reason            String
  status            String    @default("PENDING") // PENDING, SUBMITTED, VERIFIED, REJECTED
  submittedDocIds   String? // JSON string array
  createdAt         DateTime  @default(now())
  submittedAt       DateTime?
}

model AcademicSemester {
  id             String @id @default(uuid())
  studentId      String
  semesterNumber Int
  sgpa           Float
  credits        Int
  subjects       String // JSON string array of { code, name, grade, credits }
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     String
  browser    String
  ipAddress  String
  lastActive DateTime @default(now())
  isCurrent  Boolean  @default(false)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  category  String // AUTH, DOCUMENT, VERIFICATION, PLACEMENT, SECURITY, ADMIN
  details   String
  userEmail String
  ipAddress String?
  timestamp DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // VERIFICATION, REJECTION, PLACEMENT, SHARE, EXPIRY, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
